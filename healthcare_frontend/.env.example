# Frontend calls this base URL. "/api" = same-origin, forwarded to Django by the
# Vite dev proxy (see vite.config.js). Same-origin is REQUIRED for the HttpOnly
# refresh-token cookie to be sent, so in production serve the SPA and the API
# under one site (e.g. https://app.example.com and https://app.example.com/api).
VITE_API_URL=/api

# Where the dev proxy forwards /api to (your Django server)
VITE_PROXY_TARGET=http://127.0.0.1:8000
