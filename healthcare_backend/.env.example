# ---- Core -------------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ---------------------------------------------------------
# "postgres" (default) or "sqlite" (handy for local tests only)
DB_ENGINE=postgres
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Field-level encryption for patient data (REQUIRED) ----------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated list: first key encrypts, all keys can decrypt (key rotation).
# LOSING THESE KEYS MEANS LOSING THE ENCRYPTED DATA - back them up.
FIELD_ENCRYPTION_KEYS=

# ---- JWT / sessions ---------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Refresh token lives in an HttpOnly cookie. Secure defaults to (not DEBUG).
REFRESH_COOKIE_SAMESITE=Strict
# REFRESH_COOKIE_SECURE=True

# ---- CORS / trusted origins (your frontend URL(s)) --------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Throttling -------------------------------------------------------
# Number of reverse proxies in front of Django (0 = none, use socket IP).
# Do NOT set this higher than reality: clients could spoof X-Forwarded-For.
NUM_PROXIES=0
# Shared cache so limits work across several workers (optional, recommended in prod)
# REDIS_URL=redis://127.0.0.1:6379/1

# ---- Production only (DEBUG=False) ------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# Set when a TLS-terminating proxy forwards X-Forwarded-Proto:
# BEHIND_TLS_PROXY=True

LOG_LEVEL=INFO
